# ==========================================================
# CampusHub environment configuration
# Copy this file to server/.env and fill in real values.
# Never commit the real .env file.
# ==========================================================

# --- Server ---
PORT=5050
NODE_ENV=development

# --- Database ---
# Local:   mongodb://127.0.0.1:27017/campushub
# Atlas:   mongodb+srv://<user>:<password>@<cluster>/campushub
MONGODB_URI=mongodb://127.0.0.1:27017/campushub

# --- Auth ---
# Any long random string. Used to sign auth tokens.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Frontend origin (for CORS) ---
CLIENT_ORIGIN=http://localhost:5173

# ==========================================================
# Note for instructors: earlier drafts of this project toggled
# the Week 1 problems on/off with environment flags here. That
# made it possible for a student to "fix" a bug just by editing
# .env, without touching any real code, so those flags have been
# removed. Every Week 1 problem now lives permanently in the
# actual source until someone edits the source to fix it. See
# INSTRUCTOR.md for exactly where each one lives and how to
# reproduce, verify, and reset each one via git.
# ==========================================================
